# ==============================================================================
# BisTech EMS Frontend Environment Variables
# ==============================================================================

# Backend API server internal URL for Next.js rewrites and Server Components.
# In local development: http://localhost:4000
# In production on Vercel: https://bistech-ems-server.vercel.app
API_INTERNAL_URL="https://bistech-ems-server.vercel.app"

# Deployed backend server origin
NEXT_PUBLIC_SERVER_ORIGIN="https://bistech-ems-server.vercel.app"

# Session cookie name (default: ems_access)
SESSION_COOKIE_NAME="ems_access"

# API mocking mode ('enabled' or 'disabled')
NEXT_PUBLIC_API_MOCKING="disabled"

# Cloudinary configuration for media uploads
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

